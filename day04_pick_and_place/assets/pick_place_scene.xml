<mujoco model="pick_place_arm">

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
    />

    <worldbody>

        <!-- =================================================
             地面
        ================================================== -->

        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
        />


        <!-- =================================================
             机械臂基座
        ================================================== -->

        <body
            name="base"
            pos="0 0 0.15"
        >

            <geom
                name="base_geom"
                type="cylinder"
                size="0.15 0.15"
            />


            <!-- =============================================
                 Link 1
            ============================================== -->

            <body
                name="link1"
                pos="0 0 0.15"
            >

                <joint
                    name="joint1"
                    type="hinge"
                    axis="0 0 1"
                    damping="0.1"
                />

                <geom
                    name="link1_geom"
                    type="capsule"
                    fromto="0 0 0 1 0 0"
                    size="0.06"
                />


                <!-- =========================================
                     Link 2
                ========================================== -->

                <body
                    name="link2"
                    pos="1 0 0"
                >

                    <joint
                        name="joint2"
                        type="hinge"
                        axis="0 0 1"
                        damping="0.1"
                    />

                    <geom
                        name="link2_geom"
                        type="capsule"
                        fromto="0 0 0 1 0 0"
                        size="0.06"
                    />


                    <!-- 末端执行器位置 -->
                    <site
                        name="ee_site"
                        pos="1 0 0"
                        type="sphere"
                        size="0.04"
                    />

                </body>

            </body>

        </body>


        <!-- =================================================
             方块
             
             mocap=true：
             今天暂时把它作为一个可由程序移动的物体，
             用于模拟“磁吸抓取”
        ================================================== -->

        <body
            name="cube"
            mocap="true"
            pos="1.2 0.6 0.30"
        >

            <geom
                name="cube_geom"
                type="box"
                size="0.07 0.07 0.07"
                contype="0"
                conaffinity="0"
            />

        </body>


        <!-- =================================================
             放置目标位置
        ================================================== -->

        <site
            name="place_target"
            pos="0.5 1.4 0.30"
            type="sphere"
            size="0.08"
        />

    </worldbody>


    <!-- =====================================================
         排除相邻连杆碰撞
    ====================================================== -->

    <contact>

        <exclude
            body1="base"
            body2="link1"
        />

        <exclude
            body1="link1"
            body2="link2"
        />

    </contact>


    <!-- =====================================================
         两个关节执行器
    ====================================================== -->

    <actuator>

        <motor
            name="motor1"
            joint="joint1"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

        <motor
            name="motor2"
            joint="joint2"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

    </actuator>

</mujoco>