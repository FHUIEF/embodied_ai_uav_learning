<mujoco model="onea_joint_arm">

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>

        <!-- 地面 -->
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
        />

        <!-- 基座 -->
        <body name="base" pos="0 0 0.1">

            <geom
                type="cylinder"
                size="0.15 0.1"
            />

            <!-- 第一根机械臂 -->
            <body name="link1" pos="0 0 0.1">

                <!-- 旋转关节 -->
                <joint
                    name="joint1"
                    type="hinge"
                    axis="0 0 1"
                    range="-180 180"
                    damping="0.1"
                />

                <!-- 连杆 -->
                <geom
                    name="link1_geom"
                    type="capsule"
                    fromto="0 0 0 1 0 0"
                    size="0.06"
                />

            </body>

        </body>

    </worldbody>
    
    <contact>
        <exclude body1="base" body2="link1"/>
    </contact>

    
    <actuator>
        <motor
            name="motor1"
            joint="joint1"
            gear="1"
            ctrllimited="true"
            ctrlrange="-10 10"
        />
    </actuator>

</mujoco>

