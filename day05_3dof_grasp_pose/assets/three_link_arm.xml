<mujoco model="three_link_arm">

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
    />

    <worldbody>

        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
        />

        <body
            name="base"
            pos="0 0 0.15"
        >

            <geom
                name="base_geom"
                type="cylinder"
                size="0.15 0.15"
            />

            <!-- link1 -->
            <body
                name="link1"
                pos="0 0 0.15"
            >

                <joint
                    name="joint1"
                    type="hinge"
                    axis="0 0 1"
                    damping="0.2"
                />

                <geom
                    name="link1_geom"
                    type="capsule"
                    fromto="0 0 0 1.0 0 0"
                    size="0.05"
                />

                <!-- link2 -->
                <body
                    name="link2"
                    pos="1.0 0 0"
                >

                    <joint
                        name="joint2"
                        type="hinge"
                        axis="0 0 1"
                        damping="0.2"
                    />

                    <geom
                        name="link2_geom"
                        type="capsule"
                        fromto="0 0 0 0.8 0 0"
                        size="0.05"
                    />

                    <!-- link3 -->
                    <body
                        name="link3"
                        pos="0.8 0 0"
                    >

                        <joint
                            name="joint3"
                            type="hinge"
                            axis="0 0 1"
                            damping="0.2"
                        />

                        <geom
                            name="link3_geom"
                            type="capsule"
                            fromto="0 0 0 0.3 0 0"
                            size="0.04"
                        />

                        <site
                            name="ee_site"
                            pos="0.3 0 0"
                            type="sphere"
                            size="0.03"
                        />

                    </body>

                </body>

            </body>

        </body>

    </worldbody>

    <contact>

        <exclude
            body1="base"
            body2="link1"
        />

        <exclude
            body1="link1"
            body2="link2"
        />

        <exclude
            body1="link2"
            body2="link3"
        />

    </contact>

    <actuator>

        <motor
            name="motor1"
            joint="joint1"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

        <motor
            name="motor2"
            joint="joint2"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

        <motor
            name="motor3"
            joint="joint3"
            gear="1"
            ctrllimited="true"
            ctrlrange="-10 10"
        />

    </actuator>

</mujoco>