<mujoco model="three_link_gripper">

    <option
        timestep="0.002"
        gravity="0 0 0"
    />


    <worldbody>

        <!-- ===============================
             Base
        ================================ -->

        <body
            name="base"
            pos="0 0 0.30"
        >

            <geom
                name="base_geom"
                type="cylinder"
                size="0.15 0.08"
            />


            <!-- ===========================
                 Link 1
            ============================ -->

            <body
                name="link1"
                pos="0 0 0"
            >

                <joint
                    name="joint1"
                    type="hinge"
                    axis="0 0 1"
                    damping="0.2"
                />

                <geom
                    name="link1_geom"
                    type="capsule"
                    fromto="0 0 0 1.0 0 0"
                    size="0.05"
                />


                <!-- =======================
                     Link 2
                ======================== -->

                <body
                    name="link2"
                    pos="1.0 0 0"
                >

                    <joint
                        name="joint2"
                        type="hinge"
                        axis="0 0 1"
                        damping="0.2"
                    />

                    <geom
                        name="link2_geom"
                        type="capsule"
                        fromto="0 0 0 0.8 0 0"
                        size="0.05"
                    />


                    <!-- ===================
                         Link 3
                    ==================== -->

                    <body
                        name="link3"
                        pos="0.8 0 0"
                    >

                        <joint
                            name="joint3"
                            type="hinge"
                            axis="0 0 1"
                            damping="0.2"
                        />

                        <geom
                            name="link3_geom"
                            type="capsule"
                            fromto="0 0 0 0.30 0 0"
                            size="0.04"
                        />


                        <!-- =================
                             Gripper base
                        ================== -->

                        <body
                            name="gripper_base"
                            pos="0.30 0 0"
                        >

                            <geom
                                name="gripper_base_geom"
                                type="box"
                                size="0.035 0.07 0.05"
                            />


                            <!-- =================
                                 Left finger
                            ================== -->

                            <body
                                name="left_finger"
                                pos="0.20 0.16 0"
                            >

                                <joint
                                    name="left_finger_joint"
                                    type="slide"
                                    axis="0 -1 0"
                                    range="0 0.12"
                                    damping="1.0"
                                />

                                <geom
                                    name="left_finger_geom"
                                    type="box"
                                    size="0.10 0.025 0.07"
                                    friction="2.0 0.1 0.01"
                                />

                            </body>


                            <!-- =================
                                 Right finger
                            ================== -->

                            <body
                                name="right_finger"
                                pos="0.20 -0.16 0"
                            >

                                <joint
                                    name="right_finger_joint"
                                    type="slide"
                                    axis="0 1 0"
                                    range="0 0.12"
                                    damping="1.0"
                                />

                                <geom
                                    name="right_finger_geom"
                                    type="box"
                                    size="0.10 0.025 0.07"
                                    friction="2.0 0.1 0.01"
                                />

                            </body>


                            <!-- 真正的抓取中心 -->

                            <site
                                name="grasp_site"
                                pos="0.20 0 0"
                                type="sphere"
                                size="0.025"
                            />

                        </body>

                    </body>

                </body>

            </body>

        </body>


        <!-- ===============================
             Cube
        ================================ -->

        <body
            name="cube"
            pos="1.30 0.60 0.30"
        >

            <joint
                name="cube_x"
                type="slide"
                axis="1 0 0"
                damping="0.2"
            />

            <joint
                name="cube_y"
                type="slide"
                axis="0 1 0"
                damping="0.2"
            />

            <joint
                name="cube_yaw"
                type="hinge"
                axis="0 0 1"
                damping="0.1"
            />

            <geom
                name="cube_geom"
                type="box"
                size="0.06 0.06 0.06"
                mass="0.15"
                friction="2.0 0.1 0.01"
            />

        </body>


        <!-- grasp target visualization -->

        <site
            name="object_site"
            pos="1.30 0.60 0.30"
            type="sphere"
            size="0.035"
        />

    </worldbody>


    <!-- ===============================
         Contact exclusions
    ================================ -->

    <contact>

        <exclude
            body1="base"
            body2="link1"
        />

        <exclude
            body1="link1"
            body2="link2"
        />

        <exclude
            body1="link2"
            body2="link3"
        />

        <exclude
            body1="link3"
            body2="gripper_base"
        />

    </contact>


    <!-- ===============================
         Actuators
    ================================ -->

    <actuator>

        <motor
            name="motor1"
            joint="joint1"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

        <motor
            name="motor2"
            joint="joint2"
            gear="1"
            ctrllimited="true"
            ctrlrange="-20 20"
        />

        <motor
            name="motor3"
            joint="joint3"
            gear="1"
            ctrllimited="true"
            ctrlrange="-10 10"
        />


        <position
            name="left_gripper_act"
            joint="left_finger_joint"
            kp="150"
            ctrllimited="true"
            ctrlrange="0 0.08"
        />

        <position
            name="right_gripper_act"
            joint="right_finger_joint"
            kp="150"
            ctrllimited="true"
            ctrlrange="0 0.08"
        />

    </actuator>

</mujoco>